{
  "name": "learnaing",
  "productName": "LearnAIng",
  "version": "0.1.0",
  "private": true,
  "description": "Ricerca approfondita verificata e apprendimento interattivo, dati locali.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "dist:local": "electron-vite build && electron-builder --win portable",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run src",
    "test:e2e": "electron-vite build && playwright test",
    "check:sqlite": "node scripts/check-sqlite.mjs",
    "dist:ov": "electron-vite build && electron-builder --win --config signing/ov.yml",
    "dist:azure": "electron-vite build && electron-builder --win --config signing/azure.yml",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "dist:store": "electron-vite build && electron-builder --win appx --config signing/store.yml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
